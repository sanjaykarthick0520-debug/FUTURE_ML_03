generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  resumes Resume[]
}

model Resume {
  id           String   @id @default(cuid())
  title        String
  originalName String
  fileUrl      String

  targetRole   String?
  atsScore     Float?
  aiStatus     String   @default("Pending")

  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  analyses Analysis[]
}

model Analysis {
  id String @id @default(cuid())

  // Target role used during analysis
  targetRole String?

  // Main scores
  overallScore Float?
  jobMatch     Float?

  // Detailed AI score breakdown
  keywordMatch        Float?
  technicalSkills     Float?
  experienceRelevance Float?
  projectRelevance    Float?
  resumeStructure     Float?

  // AI-generated explanation
  strengths       String
  weaknesses      String
  suggestions     String
  missingKeywords String

  createdAt DateTime @default(now())

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}